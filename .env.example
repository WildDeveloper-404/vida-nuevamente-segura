MAIL_FROM_NAME="Clínica Vida Nuevamente Segura"
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
GEMINI_API_KEY=
