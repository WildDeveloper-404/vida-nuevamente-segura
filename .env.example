APP_NAME="Clínica Vida Nuevamente Segura"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/Caracas
DB_CONNECTION=pgsql
