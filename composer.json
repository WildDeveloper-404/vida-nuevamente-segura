{
  "name": "clinica/vida-nuevamente-segura",
  "type": "project",
  "description": "Gesti\u00f3n de citas m\u00e9dicas CU01 a CU18",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "barryvdh/laravel-dompdf": "^3.1",
    "endroid/qr-code": "^5.0",
    "laravel/framework": "^12.69",
    "phpoffice/phpspreadsheet": "^3.0",
    "stripe/stripe-php": "^17.0",
    "symfony/brevo-mailer": "^7.4",
    "symfony/http-client": "^7.4"
  },
  "require-dev": {
    "laravel/pint": "^1.32",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "@php vendor/bin/phpunit"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
